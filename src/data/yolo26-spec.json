    "temporal_verification": {
      "position": "Sits between YOLO26 and the alarm system.",
      "pipeline": [
        "YOLO detection",
        "confidence > threshold?",
        "same object detected repeatedly?",
        "persists for N frames?",
        "consistent bounding box?",
        "person relationship?",
        "zone rule?",
        "SECURITY EVENT"
      ],
      "effect": "This dramatically changes the system from object detection into event detection."
    },
    "confidence_policy": {
      "bands": [
        {"range": "< 0.40", "lower": 0.0, "upper_exclusive": 0.4, "action": "ignore"},
        {"range": "0.40-0.65", "lower": 0.4, "upper_exclusive": 0.65, "action": "observe"},
        {"range": "0.65-0.85", "lower": 0.65, "upper_exclusive": 0.85, "action": "suspicious"},
        {"range": "> 0.85", "lower": 0.85, "upper": 1.0, "action": "strong detection"}
      ],
      "caveat": "These values should be determined experimentally from your validation data, not treated as universal thresholds."
    }
