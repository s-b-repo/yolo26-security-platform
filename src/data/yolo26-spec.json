  "tracking_temporal": {
    "source_sections": [5, 6],
    "principle": "Use tracking and multi-frame confirmation instead of firing alarms on independent single-frame detections.",
    "multi_frame_confirmation": {
      "confirmed_pattern": [
        "Frame 1: weapon detected",
        "Frame 2: weapon detected",
        "Frame 3: weapon detected",
        "Frame 4: weapon detected",
